ernalType\":\"struct CoveringRegistry.Record\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint16\",\"name\":\"v\",\"type\":\"uint16\"},{\"internalType\":\"uint8\",\"name\":\"k\",\"type\":\"uint8\"},{\"internalType\":\"bytes\",\"name\":\"blocks\",\"type\":\"bytes\"},{\"internalType\":\"address\",\"name\":\"sponsor\",\"type\":\"address\"}],\"name\":\"submit\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"id\",\"type\":\"bytes32\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Points count from 0 and take one byte each. The certificate text format counts them from 1.\",\"kind\":\"dev\",\"methods\":{\"recordOf(uint16,uint8)\":{\"params\":{\"k\":\"Points per block.\",\"v\":\"Number of points.\"},\"returns\":{\"_0\":\"The number of blocks, the block time of the submission, the finder, the sponsor and the id.\"}},\"submit(uint16,uint8,bytes,address)\":{\"params\":{\"blocks\":\"The blocks one after another, k bytes each, one byte per point (from 0). Points must ascend within a block and blocks must ascend in lexicographic order, so a design has exactly one encoding.\",\"k\":\"Points per block, 2 to v - 1.\",\"sponsor\":\"Whoever the finder credits for the search. Not checked; may be zero.\",\"v\":\"Number of points, 3 to 255.\"},\"returns\":{\"id\":\"keccak256(abi.encodePacked(v, k, blocks)).\"}}},\"title\":\"CoveringRegistry\",\"version\":1},\"userdoc\":{\"errors\":{\"BlocksNotIncreasing(uint256)\":[{\"notice\":\"Block `index` (from 0) does not come strictly after the block before it in lexicographic order.\"}],\"InvalidLength(uint256)\":[{\"notice\":\"The design is empty or its length is not a multiple of k.\"}],\"InvalidParameters(uint16,uint8)\":[{\"notice\":\"v is not in [3, 255] or k is not in [2, v - 1].\"}],\"NotSmaller(uint32,uint32)\":[{\"notice\":\"The design has `blocks` blocks and the record for (v, k) has `record`, which is not more.\"}],\"PairNotCovered(uint8,uint8)\":[{\"notice\":\"No block holds both x and y (x < y, from 0); of all such pairs this one has the lowest index.\"}],\"PointOutOfRange(uint256)\":[{\"notice\":\"The byte at `offset` names a point that is not below v.\"}],\"PointsNotIncreasing(uint256)\":[{\"notice\":\"The byte at `offset` is not above the byte before it in its block.\"}]},\"events\":{\"Recorded(uint16,uint8,uint32,address,address,bytes32)\":{\"notice\":\"A covering became the record for (v, k).\"}},\"kind\":\"user\",\"methods\":{\"recordOf(uint16,uint8)\":{\"notice\":\"The record for (v, k). Every field is zero when there is none.\"},\"submit(uint16,uint8,bytes,address)\":{\"notice\":\"Checks a (v, k, 2) covering design and, if it has fewer blocks than the record for (v, k) or there is no record yet, stores it as the new record with the caller as finder.\"}},\"notice\":\"Keeps, for each (v, k), the (v, k, 2) covering design with the fewest blocks submitted so far. Every submission is checked in full on chain: its blocks must hold every pair of the v points.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/CoveringRegistry.sol\":\"CoveringRegistry\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"src/CoveringRegistry.sol\":{\"keccak256\":\"0xfb286190e91fcec0f6eb4b3fb04a14361b1a17f0b757232cc185fafc47711ad8\",\"license\":\"MIT OR Apache-2.0\",\"urls\":[\"bzz-raw://0ccc9a4c30290d4dece0d4abce37b34a2da90ff5adf06c55508cdcd8740933ea\",\"dweb:/ipfs/QmV5inqBxWigak9rJcJhbH1dhchampsuVCTqhtRmnLjpXe\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.28+commit.7893614a"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"uint256","name":"index","type":"uint256"}],"type":"error","name":"BlocksNotIncreasing"},{"inputs":[{"internalType":"uint256","name":"length","type":"uint256"}],"type":"error","name":"